NAS_UID=1026
NAS_GID=100
NAS_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Browser origin only (no /production path). Empty disables Pages access.
PAGES_ORIGINS=

# Only needed for creating the first account; keep actual values in NAS .env.
ADMIN_EMAIL=
ADMIN_NAME=
# Optional existing member ID. Existing profile fields will be preserved.
ADMIN_MEMBER_ID=
ADMIN_SETUP_CODE=
