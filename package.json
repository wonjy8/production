{
  "name": "production-note",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-production.mjs && bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "build:production": "node scripts/build-production.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "docs:clean": "node scripts/clean-docs.mjs",
    "docs:check": "node scripts/clean-docs.mjs --check",
    "prebuild": "npm run docs:clean",
    "prebuild:production": "npm run docs:clean",
    "prebuild:pages": "npm run docs:clean",
    "typecheck:modules": "node scripts/check-module-language.mjs && tsc -p tsconfig.modules.json"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.27.3",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx": "^9.10.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "unicode-emoji-json": "0.9.0"
  }
}
